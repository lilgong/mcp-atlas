# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# These are source-controlled runtime overlays despite living below package
# directories named "build" and "dist".
!services/agent-environment/vendor/yibu-patched/node_modules/@modelcontextprotocol/server-brave-search/dist/
!services/agent-environment/vendor/yibu-patched/node_modules/@modelcontextprotocol/server-brave-search/dist/**
!services/agent-environment/vendor/yibu-patched/node_modules/exa-mcp-server/build/
!services/agent-environment/vendor/yibu-patched/node_modules/exa-mcp-server/build/**

# Virtual environments
.venv

# Ruff
.ruff_cache

.DS_Store

.env*

# Local Chinese-annotated copy of env.template, grouped by how often each
# setting changes. Kept out of the repo; env.template stays the source of truth.
env.template.zh
MCP-Atlas.jsonl
# Local runtime material and Slack-free derivatives.
.runtime/
services/mcp_eval/MCP-Atlas.slack-aligned.csv
services/mcp_eval/MCP-Atlas*.csv.bak
services/mcp_eval/MCP-Atlas.origin.csv
data_exports/slack_mcp_eval_export_[0-9]*.zip

# Eval results (keep folders, ignore contents)
services/mcp_eval/completion_results/*
services/mcp_eval/evaluation_results/*
!services/mcp_eval/completion_results/.gitkeep
!services/mcp_eval/evaluation_results/.gitkeep

# MCP/tool API call logs (per-key request counts)
mcp_usage_log/
token_usage_log/
