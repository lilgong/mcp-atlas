# Python-generated files
__pycache__/
*.py[oc]
*.egg-info
build/
dist/

# Virtual environments (will create fresh in Docker)
.venv/
venv/

# Test and dev files
tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Git (submodules are cloned fresh in Dockerfile)
.git/
.gitignore
.gitattributes

# Environment files (use --env-file with docker run instead)
.env
.env.*

# Locally generated/backup MCP configs are not runtime sources. The entrypoint
# renders mcp_server_config.json from the tracked template inside each container.
src/agent_environment/mcp_server_config_docker.json
src/agent_environment/mcp_server_template_backup.json

# MCP servers' runtime caches. slack-mcp-server writes its channel/user list to
# these in its working directory; if you've run it here they sit in the build
# context and COPY . . bakes them into the image. Every container then starts
# with a frozen channel list from whatever workspace was cached at build time,
# and slack_channels_list serves that instead of querying Slack — so freshly
# imported channels are invisible and every slack task silently scores zero.
.channels_cache_v2.json
.users_cache.json
