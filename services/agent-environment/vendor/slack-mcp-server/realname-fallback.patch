+func effectiveRealName(user slack.User) string {
+	for _, candidate := range []string{user.RealName, user.Profile.RealName, user.Profile.DisplayName, user.Name} {
+		if strings.TrimSpace(candidate) != "" {
+			return candidate
+		}
+	}
+	return ""
