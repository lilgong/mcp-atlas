+func TestUnitEffectiveRealName(t *testing.T) {
+	tests := []struct {
+		name string
+		user slack.User
+		want string
+	}{
+		{
+			name: "top-level real name keeps official behavior",
+			user: slack.User{Name: "handle", RealName: "Top Level", Profile: slack.UserProfile{RealName: "Profile Name"}},
+			want: "Top Level",
+		},
+		{
+			name: "deactivated imported user uses profile real name",
+			user: slack.User{Name: "shinsplints7070", Profile: slack.UserProfile{RealName: "steve_shins", DisplayName: "Steve"}},
+			want: "steve_shins",
+		},
+		{
+			name: "display name is the next fallback",
+			user: slack.User{Name: "handle", Profile: slack.UserProfile{DisplayName: "Display Name"}},
+			want: "Display Name",
+		},
+		{
+			name: "username is always available as a final fallback",
+			user: slack.User{Name: "handle"},
+			want: "handle",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, effectiveRealName(tt.user))
+		})
+	}
+}
