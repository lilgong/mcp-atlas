# MCP-Atlas env template
#
# 文件分三段：
#   第 1 段  每次实验常改：模型、输入输出、并发
#   第 2 段  环境搭建时配置：凭证、端点、镜像、路径、端口、日志
#   第 3 段  通常不改：超时、重试、返回体积、沙箱资源与回收


# =============================================================
# 第 1 段：每次实验常改
# =============================================================

# 生成轨迹（mcp_completion_script.py）。命令行参数优先于这里。
MCP_COMPLETION_MODEL=openai/glm-5.2-thinking
MCP_COMPLETION_INPUT=MCP-Atlas.csv

# Optional PubMed E-utilities identity. The runtime stays below the anonymous
# request limit even without a key; a key raises NCBI's normal per-key quota but
# does not itself remove an already active IP abuse block.
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=mcp_atlas_eval
# 可选：把所有任务的 NCBI/PMC HTTP 请求汇聚到同一限速出口。
# relay 使用 IPWO 动态住宅代理，四项代理配置缺一时拒绝启动。
# 代理凭证只配置在 relay 主机，不会传入 MCP 子进程。
# 同一 relay 也承接 Wikipedia Action API。URL 与 TOKEN 必须同时设置；
# 留空则 PubMed/Wikipedia 仍由本机直接访问。
PUBMED_RELAY_URL=
PUBMED_RELAY_TOKEN=
PUBMED_RELAY_TIMEOUT_SECONDS=90
# 仅启动 scripts/pubmed_relay_server.py 的主机需要填写。
PUBMED_RELAY_BIND=127.0.0.1
PUBMED_RELAY_PORT=3985
PUBMED_RELAY_USAGE_LOG=completion_results/runtime_logs/pubmed-relay-usage.jsonl
IPWO_PROXY_HOST=
IPWO_PROXY_PORT=
IPWO_PROXY_USERNAME=
IPWO_PROXY_PASSWORD=
# NCBI 对全球随机出口兼容性差，建议使用 US；每次请求仍会轮换 sid。
IPWO_PROXY_COUNTRY=US
MCP_COMPLETION_OUTPUT=MCP-Atlas-glm-5.2-thinking.csv
# 留空表示运行全部任务。
MCP_COMPLETION_NUM_TASKS=
MCP_COMPLETION_CONCURRENCY=30
# 原样透传给模型供应商。需要关闭思考时，按模型协议改成对应参数，例如：
# {"thinking":{"type":"disabled"}}
MCP_COMPLETION_EXTRA_BODY={"thinking":{"type":"enabled"},"reasoning_effort":"max"}
# 默认关闭：部分模型快思考返回包含think内容，默认允许。
# SFT 数据生产若要拒绝泄漏响应，可改成 true（单轮最多尝试 3 次）。
MCP_COMPLETION_RETRY_THINKING_CONTRACT_VIOLATIONS=false

# 打分（mcp_evals_scores.py）。留空则必须传 --input-file 和 --model-label。
EVAL_INPUT_FILE=
EVAL_MODEL_LABEL=

# 是否给被测模型增加系统提示词。留空/false 表示不增加。
USE_SYSTEM_PROMPT_IN_COMPLETION=


# =============================================================
# 第 2 段：环境搭建时配置
# =============================================================

# ---------- 被测模型与评委模型 ----------

# 生成轨迹使用的 OpenAI 兼容端点（LiteLLM）。
LLM_API_KEY=
LLM_BASE_URL=https://yibuapi.com/v1

# 打分评委模型；API key/base 留空时回退到 LLM_API_KEY/LLM_BASE_URL。
EVAL_LLM_MODEL=openai/gpt-5.4
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=https://yibuapi.com/v1

# 盘古专用通道；留空时分别回退到 LLM_API_KEY 和 LLM_BASE_URL。
PANGU_API_KEY=
PANGU_API_URL=

# ---------- MCP 服务选择 ----------

# 留空 = 默认服务 + 自动启用已经配置凭证的服务。
# 显式填写时作为全局 allowlist，只启用列出的共享及任务沙箱服务，例如：
# ENABLED_SERVERS=calculator,wikipedia,github
ENABLED_SERVERS=

# ---------- MCP 第三方凭证 ----------

# Airtable
# https://github.com/felores/airtable-mcp#obtaining-an-airtable-api-key
AIRTABLE_API_KEY=

# Alchemy
# https://www.alchemy.com/docs/
ALCHEMY_API_KEY=

# Brave Search（当前 yibu profile 也使用此字段）
BRAVE_API_KEY=

# Context7
# https://context7.com/dashboard
CONTEXT7_API_KEY=

# E2B
# https://e2b.dev/
E2B_API_KEY=

# Exa（当前 yibu profile 也使用此字段）
EXA_API_KEY=

# GitHub
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Lara Translate
# Yibu 模式只填 LARA_YIBU_API_KEY；官方模式留空该项并填写下面两项。
LARA_YIBU_API_KEY=
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# National Parks
NPS_API_KEY=

# MongoDB。Docker 中使用 Atlas/SRV 地址时通常需要追加 ?tls=true。
MONGODB_CONNECTION_STRING=

# Notion
NOTION_TOKEN=
NOTION_PAGE_ID=

# Oxylabs（当前 yibu profile）。URL 不能留空，否则会覆盖包内默认值并导致
# 服务无法注册工具。
OXYLABS_USERNAME=atlas_oxylabs
OXYLABS_PASSWORD=
OXYLABS_SCRAPER_URL=https://yibuapi.com/oxylabs/v1/queries

# Slack
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=

# Twelve Data
TWELVE_DATA_API_KEY=

# Weather Data
WEATHER_API_KEY=
# 可选 Yibu 传输；填写后 weather-data 的官方 9 个 MCP 工具与
# schema 不变，仅把 WeatherAPI HTTP 请求改为 Yibu Bearer 鉴权。
# 留空时继续使用上面的 WEATHER_API_KEY 官方直连。
WEATHER_YIBU_API_KEY=

# ---------- 共享 MCP 与任务沙箱 ----------

# 必须仅监听宿主回环；task-local 容器允许出站联网，不能访问共享控制面。
MCP_SHARED_HOST=127.0.0.1
MCP_SHARED_PORT=1984
MCP_SERVER_URL=http://localhost:${MCP_SHARED_PORT}

# 按顺序尝试的 OSM Overpass 端点。当前网络不使用会长时间卡住的
# overpass.private.coffee。
SYN_OSM_OVERPASS_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter

# 共享服务和任务沙箱使用同一无 fixture runtime 镜像。
MCP_TASK_ISOLATION_ENABLED=true
MCP_SHARED_AGENT_IMAGE=mcp-atlas-runtime:latest
MCP_TASK_AGENT_IMAGE=mcp-atlas-runtime:latest
# 必填：使用 scripts/prepare_task_data_fixture.py 生成后填写绝对路径。
MCP_TASK_DATA_DIR=
# 可选：每道题的一次性工作目录根路径；留空使用系统临时目录。
MCP_TASK_WORKSPACE_ROOT=
# 可选：跨题复用的 Git 裸仓库缓存；留空时放在上述工作目录根路径下。
MCP_GIT_CACHE_DIR=
# 仅 MongoDB 任务需要，使用 scripts/build_task_mongo_fixture.py 构建。
MCP_TASK_MONGO_IMAGE=

# ---------- Completion 服务 ----------

# 必须仅监听宿主回环。远程使用请通过 SSH 端口转发。
HOST=127.0.0.1
PORT=3500
# 必须和 PORT 一致；python-dotenv 会展开 ${PORT}。
SERVER_URL=http://localhost:${PORT}

# ---------- 日志 ----------

TOKEN_LOG_DIR=token_usage_log
EVAL_TOKEN_LOG_DIR=${TOKEN_LOG_DIR}
PANGU_LOG_DIR=completion_results/pangu_log
PANGU_LOG_PATH=
MCP_RUNTIME_LOG_DIR=completion_results/runtime_logs

# MCP 工具 API 请求日志的宿主机目录。共享容器会把它挂载到容器内，建议填写
# 当前机器上的绝对路径。
MCP_USAGE_LOG_DIR=/absolute/path/to/mcp-atlas/mcp_usage_log

LOG_LEVEL=INFO

# MCP 子进程冷启动预算。大量 server 并发初始化时，weather 等 Git 源依赖可能
# 超过旧的 25 秒默认值；外层 discovery 应略大于 client initialize。
MCP_CLIENT_INIT_TIMEOUT_SECONDS=45
MCP_DISCOVERY_TIMEOUT_SECONDS=50


# =============================================================
# 第 3 段：通常不改的调优项
# =============================================================

# ---------- 超时与重试 ----------

DEFAULT_TIMEOUT=300.0
TOOL_CALL_TIMEOUT=180.0
LIST_TOOLS_TIMEOUT=180.0

# 一个完整任务（最多 256 轮）的墙钟时间上限。
TASK_REQUEST_TIMEOUT=3600
# 超时通常可复现，因此单独限制超时重跑次数。
MAX_TIMEOUT_ATTEMPTS=2

# 普通失败的任务级总尝试次数。
MAX_RETRY_ATTEMPTS=3

# 路由预检允许共享 MCP 瞬时健康状态恢复。
MCP_ROUTE_PREFLIGHT_ATTEMPTS=3
MCP_ROUTE_PREFLIGHT_RETRY_DELAY=1

# 评委模型判定单条 claim 的时间上限。
EVAL_REQUEST_TIMEOUT=120

# 盘古通道。
PANGU_TIMEOUT=1800
PANGU_MAX_RETRIES=5
PANGU_RETRY_DELAY=3

# ---------- 工具返回体积 ----------

# 默认不截断，与官方 harness 一致；需要保护上下文时可设置正整数。
MAX_TOOL_RESULT_CHARS=0
MAX_TURN_TOOL_RESULT_CHARS=0

# 供应商返回缺失 function.name 的工具调用时，最多允许模型连续重发几轮。
MAX_MALFORMED_TOOL_CALL_TURNS=2

# ---------- 任务沙箱资源与回收 ----------

MCP_TASK_SANDBOX_CONCURRENCY=20
# 同机同一用户并跑 Atlas 与 data-syn 时，留空即可自动共享
# arXiv/Brave/OSM/TwelveData/Wikipedia 门控。
# 仅需把锁文件移到其他本地磁盘时填写；不能使用 NFS。
MCP_SHARED_RATE_LIMIT_DIR=
MCP_TASK_SANDBOX_STARTUP_TIMEOUT=180
MCP_TASK_SANDBOX_MEMORY=3g
MCP_TASK_SANDBOX_CPUS=2.0
MCP_TASK_MONGO_MEMORY=1g
MCP_TASK_MONGO_CPUS=1.0

# 留空时由 hostname + PORT 推导。回收仅处理属于当前 owner 的资源。
MCP_SANDBOX_OWNER=
# 周期性回收同时满足“未被当前进程登记”和“超过最大年龄”的孤儿资源。
MCP_SANDBOX_SWEEP_INTERVAL=300
MCP_SANDBOX_ORPHAN_MAX_AGE=1800
# 单条 docker rm / volume rm 命令的时间上限及回收并发。
MCP_SANDBOX_TEARDOWN_TIMEOUT=90
MCP_SANDBOX_REAP_CONCURRENCY=4
