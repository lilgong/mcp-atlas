# API Keys for MCP Servers
# Copy this file to .env and add your own API keys

# Server Selection
# Leave empty (default) to use: default servers + auto-detect servers with API keys (detection logic in mcp_client.py)
#   Default servers (no API keys): arxiv,calculator,cli-mcp-server,clinicaltrialsgov-mcp-server,context7,ddg-search,desktop-commander,fetch,filesystem,git,mcp-code-executor,mcp-server-code-runner,memory,met-museum,open-library,osm-mcp-server,pubmed,weather,whois,wikipedia
# 
# Set explicitly to use ONLY those servers (no auto-detection):
#   ENABLED_SERVERS=calculator,wikipedia,github
# 
ENABLED_SERVERS=


# Airtable
# https://github.com/felores/airtable-mcp?tab=readme-ov-file#obtaining-an-airtable-api-key
AIRTABLE_API_KEY=

# Alchemy
# https://www.alchemy.com/docs/
ALCHEMY_API_KEY=

# Brave Search
# https://brave.com/search/api/
BRAVE_API_KEY=

# E2B
# https://e2b.dev/
E2B_API_KEY=

# Exa
# https://exa.ai/
EXA_API_KEY=

# GitHub
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Maps
# https://www.npmjs.com/package/@modelcontextprotocol/server-google-maps#setup
GOOGLE_MAPS_API_KEY=

# Google Workspace (Gmail API and Google Calendar API in Google Cloud Console)
# https://www.npmjs.com/package/@geobio/google-workspace-server#prerequisites
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Lara Translate
# https://developers.laratranslate.com/docs/introduction
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# National Parks
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# MongoDB
# Note: Add ?tls=true to the connection string for proper TLS negotiation in Docker environments
# Example: mongodb+srv://username:password@cluster.mongodb.net/?tls=true
MONGODB_CONNECTION_STRING=

# Notion
# https://github.com/makenotion/notion-mcp-server?tab=readme-ov-file#installation
NOTION_TOKEN=

# Oxylabs
# https://oxylabs.io/products/scraper-api/web
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Scraper API base URL. The template passes this through, so leaving it blank makes
# envsubst write an empty value that overrides the packaged default and the server
# then registers no tools. Set it (e.g. the API-gateway queries endpoint).
OXYLABS_SCRAPER_URL=

# Slack
# https://github.com/korotovsky/slack-mcp-server/blob/master/docs/01-authentication-setup.md
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=

# Twelve Data
# https://twelvedata.com/docs
TWELVE_DATA_API_KEY=

# Weather Data
# https://www.weatherapi.com/
WEATHER_API_KEY=




# Evaluation Script (mcp_evals_scores.py) - uses LiteLLM - EVAL_LLM_BASE_URL defaults to official provider APIs
# Falls back to LLM_API_KEY and LLM_BASE_URL if not set
EVAL_LLM_MODEL=gemini/gemini-2.5-pro
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=

# Verified re-scoring (atlas-verified/altas-verfied.py) - uses the OpenAI SDK against an
# OpenAI-compatible endpoint. Falls back to EVAL_LLM_* then LLM_* if the VERIFY_* var is blank.
VERIFY_LLM_MODEL=gpt-5.4
VERIFY_LLM_API_KEY=
VERIFY_LLM_BASE_URL=

# Agent Completion (mcp_completion_script.py) - uses LiteLLM - LLM_BASE_URL defaults to official provider APIs
# Completion model not set here, is passed as --model CLI argument
LLM_API_KEY=
LLM_BASE_URL=

# Pangu completion (mcp_completion/pangu_completion.py)
# If left blank, PANGU_API_KEY falls back to LLM_API_KEY and PANGU_API_URL falls back to LLM_BASE_URL.
PANGU_API_KEY=
PANGU_API_URL=
PANGU_TIMEOUT=1800
PANGU_MAX_RETRIES=5
PANGU_RETRY_DELAY=3

# Frequently changed inference parameters (mcp_completion_script.py)
# Command-line arguments still override these values.
MCP_COMPLETION_MODEL=pangu/92B-B005-stage2-9250-agent
MCP_COMPLETION_INPUT=MCP-Atlas.csv
MCP_COMPLETION_OUTPUT=MCP-Atlas-92B-B005-stage2-9250-new.csv
# Empty means run all tasks.
MCP_COMPLETION_NUM_TASKS=
MCP_COMPLETION_CONCURRENCY=30

# Frequently changed scoring parameters (mcp_evals_scores.py)
# Empty values mean you must pass --input-file and --model-label on the command line.
EVAL_INPUT_FILE=
EVAL_MODEL_LABEL=

# Verified re-scoring parameters (atlas-verified/altas-verfied.py)
# Input is the scored_*.csv produced by mcp_evals_scores.py. CLI args still override these.
VERIFY_INPUT_FILE=
VERIFY_CONCURRENCY=20
VERIFY_PASS_THRESHOLD=0.75

# Token/debug logs. On your server you can set these to absolute paths, for example:
# TOKEN_LOG_DIR=/home/lny/mcp-atlas/token_usage_log
# EVAL_TOKEN_LOG_DIR=/home/lny/mcp-atlas/token_usage_log
# PANGU_LOG_DIR=/home/lny/mcp-atlas/services/mcp_eval/completion_results
TOKEN_LOG_DIR=token_usage_log
EVAL_TOKEN_LOG_DIR=token_usage_log
# Verified re-scoring token log dir; falls back to EVAL_TOKEN_LOG_DIR then TOKEN_LOG_DIR.
VERIFY_TOKEN_LOG_DIR=token_usage_log
PANGU_LOG_DIR=completion_results
PANGU_LOG_PATH=

# System prompt for agent completion (default: false, no system prompt)
# With system prompt enabled, pass rate is ~10% higher (see SYSTEM_PROMPT in mcp_completion_script.py)
USE_SYSTEM_PROMPT_IN_COMPLETION=




# MCP Server configuration (we expect the agent-environment server to be running and respond to POST /list-tools and /call-tool)
# MCP_SERVER_URL=http://localhost:1984

# MCP Completion Script configuration (mcp_completion_script.py) - optional, already have defaults
# URL for the completion service that runs the agent loop (default: http://localhost:3000)
# SERVER_URL=http://localhost:3000
# Maximum retry attempts for failed API calls (default: 3)
# MAX_RETRY_ATTEMPTS=3

# MCP Completion Service Server Configuration
HOST=0.0.0.0
PORT=3000

# Timeout configuration for MCP completion service (in seconds)
DEFAULT_TIMEOUT=300.0
TOOL_CALL_TIMEOUT=60.0
LIST_TOOLS_TIMEOUT=180.0

# Logging
LOG_LEVEL=INFO
