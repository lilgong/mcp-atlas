# API Keys for MCP Servers
# Copy this file to .env and add your own API keys

# Server Selection
# Leave empty (default) to use: default servers + auto-detect servers with API keys (detection logic in mcp_client.py)
#   Default servers (no API keys): arxiv,calculator,cli-mcp-server,clinicaltrialsgov-mcp-server,context7,ddg-search,desktop-commander,fetch,filesystem,git,mcp-code-executor,mcp-server-code-runner,memory,met-museum,open-library,osm-mcp-server,pubmed,weather,whois,wikipedia
# 
# Set explicitly to use ONLY those servers (no auto-detection):
#   ENABLED_SERVERS=calculator,wikipedia,github
# 
# Optional ordered Overpass endpoints. Blank uses official, Kumi, then Mail.ru.
SYN_OSM_OVERPASS_URLS=

ENABLED_SERVERS=


# Airtable
# https://github.com/felores/airtable-mcp?tab=readme-ov-file#obtaining-an-airtable-api-key
AIRTABLE_API_KEY=

# Alchemy
# https://www.alchemy.com/docs/
ALCHEMY_API_KEY=

# Context7 (optional for small checks; recommended for batch evaluation)
# https://context7.com/dashboard
CONTEXT7_API_KEY=

# Brave Search
# https://brave.com/search/api/
BRAVE_API_KEY=

# E2B
# https://e2b.dev/
E2B_API_KEY=

# Exa
# https://exa.ai/
EXA_API_KEY=

# GitHub
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Maps
# https://www.npmjs.com/package/@modelcontextprotocol/server-google-maps#setup
GOOGLE_MAPS_API_KEY=

# Google Workspace (Gmail API and Google Calendar API in Google Cloud Console)
# https://www.npmjs.com/package/@geobio/google-workspace-server#prerequisites
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Lara Translate
# https://developers.laratranslate.com/docs/introduction
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# National Parks
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# MongoDB
# Note: Add ?tls=true to the connection string for proper TLS negotiation in Docker environments
# Example: mongodb+srv://username:password@cluster.mongodb.net/?tls=true
MONGODB_CONNECTION_STRING=

# Notion
# https://github.com/makenotion/notion-mcp-server?tab=readme-ov-file#installation
NOTION_TOKEN=

# Oxylabs
# https://oxylabs.io/products/scraper-api/web
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Scraper API base URL. The template passes this through, so leaving it blank makes
# envsubst write an empty value that overrides the packaged default and the server
# then registers no tools. Set it (e.g. the API-gateway queries endpoint).
OXYLABS_SCRAPER_URL=

# Slack
# https://github.com/korotovsky/slack-mcp-server/blob/master/docs/01-authentication-setup.md
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=

# Twelve Data
# https://twelvedata.com/docs
TWELVE_DATA_API_KEY=

# Weather Data
# https://www.weatherapi.com/
WEATHER_API_KEY=




# Evaluation Script (mcp_evals_scores.py) - uses LiteLLM - EVAL_LLM_BASE_URL defaults to official provider APIs
# Falls back to LLM_API_KEY and LLM_BASE_URL if not set
EVAL_LLM_MODEL=gemini/gemini-2.5-pro
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
# Per-request wall clock for judging one claim. Without it litellm's 6000s
# default applies, so a single upstream stall holds a concurrency slot for an
# hour and starves every queued claim behind it.
EVAL_REQUEST_TIMEOUT=120

# Verified re-scoring (atlas-verified/altas-verfied.py) - uses the OpenAI SDK against an
# OpenAI-compatible endpoint. Falls back to EVAL_LLM_* then LLM_* if the VERIFY_* var is blank.
VERIFY_LLM_MODEL=gpt-5.4
VERIFY_LLM_API_KEY=
VERIFY_LLM_BASE_URL=

# Agent Completion (mcp_completion_script.py) - uses LiteLLM - LLM_BASE_URL defaults to official provider APIs
# Completion model not set here, is passed as --model CLI argument
LLM_API_KEY=
LLM_BASE_URL=

# Pangu completion (mcp_completion/pangu_completion.py)
# If left blank, PANGU_API_KEY falls back to LLM_API_KEY and PANGU_API_URL falls back to LLM_BASE_URL.
PANGU_API_KEY=
PANGU_API_URL=
PANGU_TIMEOUT=1800
PANGU_MAX_RETRIES=5
PANGU_RETRY_DELAY=3

# Frequently changed inference parameters (mcp_completion_script.py)
# Command-line arguments still override these values.
MCP_COMPLETION_MODEL=pangu/92B-B005-stage2-9250-agent
MCP_COMPLETION_INPUT=MCP-Atlas.csv
MCP_COMPLETION_OUTPUT=MCP-Atlas-92B-B005-stage2-9250-new.csv
# Empty means run all tasks.
MCP_COMPLETION_NUM_TASKS=
MCP_COMPLETION_CONCURRENCY=20
# Raw provider request fields. Command-line --extra-body overrides this value.
# Example for an OpenAI-compatible reasoning model:
MCP_COMPLETION_EXTRA_BODY={"reasoning_effort":"max"}

# Frequently changed scoring parameters (mcp_evals_scores.py)
# Empty values mean you must pass --input-file and --model-label on the command line.
EVAL_INPUT_FILE=
EVAL_MODEL_LABEL=

# Verified re-scoring parameters (atlas-verified/altas-verfied.py)
# Input is the scored_*.csv produced by mcp_evals_scores.py. CLI args still override these.
VERIFY_INPUT_FILE=
VERIFY_CONCURRENCY=20
VERIFY_PASS_THRESHOLD=0.75

# Token/debug logs. On your server you can set these to absolute paths, for example:
# TOKEN_LOG_DIR=/home/lny/mcp-atlas/token_usage_log
# EVAL_TOKEN_LOG_DIR=/home/lny/mcp-atlas/token_usage_log
# PANGU_LOG_DIR=/home/lny/mcp-atlas/services/mcp_eval/completion_results
# MCP_RUNTIME_LOG_DIR=/home/lny/mcp-atlas/services/mcp_eval/completion_results/runtime_logs
TOKEN_LOG_DIR=token_usage_log
EVAL_TOKEN_LOG_DIR=token_usage_log
# Verified re-scoring token log dir; falls back to EVAL_TOKEN_LOG_DIR then TOKEN_LOG_DIR.
VERIFY_TOKEN_LOG_DIR=token_usage_log
PANGU_LOG_DIR=completion_results
PANGU_LOG_PATH=
# Every model request/response/error, tool call, and task-container lifecycle is
# appended as JSONL below this directory. Container stdout/stderr is kept in a
# per-task subdirectory.
MCP_RUNTIME_LOG_DIR=completion_results/runtime_logs

# System prompt for agent completion (default: false, no system prompt)
# With system prompt enabled, pass rate is ~10% higher (see SYSTEM_PROMPT in mcp_completion_script.py)
USE_SYSTEM_PROMPT_IN_COMPLETION=




# Shared credentialed MCP server. The completion runtime uses it only for cloud
# read tools. Local/mutable tools are routed to disposable task containers.
MCP_SHARED_HOST=0.0.0.0
MCP_SHARED_PORT=1984
MCP_SERVER_URL=http://localhost:${MCP_SHARED_PORT}

# Fixture-free runtime. Both shared and per-task containers use the same
# versioned image; task /data is copied from MCP_TASK_DATA_DIR.
MCP_TASK_ISOLATION_ENABLED=true
MCP_SHARED_AGENT_IMAGE=mcp-atlas-runtime:latest
MCP_TASK_AGENT_IMAGE=mcp-atlas-runtime:latest
# Required for isolated local/network tasks. Prepare it with
# scripts/prepare_task_data_fixture.py, then paste the absolute path printed by
# `realpath .runtime/fixtures/official-data-v2`.
MCP_TASK_DATA_DIR=
# Required only for Mongo tasks. The official runbook builds the official
# video_game_store dump as mcp-task-mongo:official-video-game-store-v1.
MCP_TASK_MONGO_IMAGE=
MCP_TASK_SANDBOX_CONCURRENCY=20
MCP_TASK_SANDBOX_STARTUP_TIMEOUT=180
MCP_TASK_SANDBOX_MEMORY=3g
MCP_TASK_SANDBOX_CPUS=2.0
MCP_TASK_MONGO_MEMORY=1g
MCP_TASK_MONGO_CPUS=1.0
# Optional stable owner used to reap orphan containers after a service restart.
# The default is derived from hostname + PORT.
MCP_SANDBOX_OWNER=
# Startup reaping only catches leaks from a previous process. These sweep for
# sandboxes orphaned while the service stays up (interrupted teardown), which
# otherwise hold memory and CPU indefinitely. A container is only reclaimed
# once it is untracked AND older than the max age.
MCP_SANDBOX_SWEEP_INTERVAL=300
MCP_SANDBOX_ORPHAN_MAX_AGE=1800
# Per-command budget for teardown (docker rm / volume rm). 20s was too tight:
# with 30 tasks concurrently creating and removing containers the daemon queues
# and the removal overruns it. Teardown failures are logged and left to the
# sweeper - they never fail the task, whose answer is already complete.
MCP_SANDBOX_TEARDOWN_TIMEOUT=90

# MCP Completion Script configuration (mcp_completion_script.py) - optional, already have defaults
# Maximum retry attempts for failed API calls (default: 3)
# MAX_RETRY_ATTEMPTS=3
# Per-request wall clock budget. A long-context task can legitimately run for
# most of an hour, so this only catches genuinely wedged requests.
TASK_REQUEST_TIMEOUT=3600
# Timeouts are deterministic, so an identical retry burns the same budget for
# the same result. Kept well below MAX_RETRY_ATTEMPTS on purpose.
MAX_TIMEOUT_ATTEMPTS=2
# Route filtering retries transient shared-MCP health snapshots before deciding
# whether a ground-truth trajectory can run.
MCP_ROUTE_PREFLIGHT_ATTEMPTS=3
MCP_ROUTE_PREFLIGHT_RETRY_DELAY=1

# MCP Completion Service Server Configuration
HOST=0.0.0.0
PORT=3000
# Keep this synchronized with PORT. python-dotenv expands ${PORT}.
SERVER_URL=http://localhost:${PORT}

# Timeout configuration for MCP completion service (in seconds)
DEFAULT_TIMEOUT=300.0
TOOL_CALL_TIMEOUT=180.0
LIST_TOOLS_TIMEOUT=180.0

# Per-tool-call character budget. An unfiltered search can return hundreds of
# KB, and that result is re-sent on every later turn. Set to 0 to disable.
MAX_TOOL_RESULT_CHARS=120000
# Combined budget for all tool calls in one turn, shared out across them. The
# per-call cap alone is defeated by parallel calls: seven calls each clipped to
# 120k still add 840k characters in a single turn.
MAX_TURN_TOOL_RESULT_CHARS=150000

# Some providers emit a tool call whose function.name is null. Those calls are
# dropped and the model is asked to reissue them; this bounds how many
# consecutive turns may be spent on that before the task simply ends with what
# it has. Previously one such call failed the whole task and the caller paid
# for a full rerun that reproduced the same defect.
MAX_MALFORMED_TOOL_CALL_TURNS=2

# Logging
LOG_LEVEL=INFO

# Per-key request logs for MCP/tool APIs (Brave, Exa, Oxylabs).
# Separate from token_usage_log/, which records LLM token usage only.
# Written as mcp_usage_log/YYYY-MM/{service}_{key_suffix}_{date}.jsonl.
# Relative paths resolve against each MCP server's own cwd, which is not
# guaranteed — set an absolute path to keep all logs in one place.
# Host directory mounted into the shared MCP container at /mcp-usage-log.
MCP_USAGE_LOG_DIR=/absolute/path/to/mcp_usage_log
