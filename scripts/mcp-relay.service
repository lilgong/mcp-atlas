[Unit]
Description=MCP-Atlas egress relay through IPWO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-relay
Group=mcp-relay
WorkingDirectory=/opt/mcp-relay
Environment=MCP_RELAY_USAGE_LOG=/var/log/mcp-relay/usage.jsonl
EnvironmentFile=/etc/mcp-relay.env
LogsDirectory=mcp-relay
ExecStart=/usr/bin/python3 /opt/mcp-relay/egress_relay.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/mcp-relay

[Install]
WantedBy=multi-user.target
