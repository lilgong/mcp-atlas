[Unit]
Description=MCP Atlas relay with live HTTP limits and durable audit
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mcp-atlas
Environment=MCP_RELAY_USAGE_LOG=%h/mcphub/data/relay/usage.jsonl
ExecStart=%h/.local/bin/uv run --env-file .env python scripts/pubmed_relay_server.py
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
